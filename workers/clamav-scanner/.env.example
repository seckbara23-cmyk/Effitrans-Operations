# ---------------------------------------------------------------------------
# Effitrans ClamAV worker — environment template.
#
# NO REAL SECRET BELONGS IN THIS FILE. It is committed; the values below are
# placeholders. Set the real ones in the host's secret store.
# ---------------------------------------------------------------------------

# REQUIRED. The shared secret, identical to CUSTOMS_SCAN_CALLBACK_SECRET on the
# Effitrans side. It signs BOTH directions: inbound requests and outbound
# verdicts. Generate with: openssl rand -hex 32
EFFITRANS_SCAN_SECRET=replace-me-with-32-bytes-of-hex

# REQUIRED. Where verdicts are POSTed.
EFFITRANS_CALLBACK_URL=https://effitrans-operations.vercel.app/api/customs/reference/scan-callback

# Worker HTTP port (the ONLY port published).
PORT=8080

# clamd — localhost inside the container. Never publish 3310.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Refuse a dispatch whose issued_at is outside this window (ms). Mirrors
# Effitrans' own callback window.
MAX_REQUEST_SKEW_MS=300000

# The signed download URL lives 300 s; give up well inside it (ms).
DOWNLOAD_TIMEOUT_MS=120000

# A scan slower than this is reported ERROR, never CLEAN (ms).
SCAN_TIMEOUT_MS=180000

# Hard ceiling on bytes pulled from the signed URL.
MAX_BYTES=67108864

# Simultaneous scans. ClamAV holds ~1 GB resident; 2 is right for a 4 GB box.
SCAN_CONCURRENCY=2

# Queue depth before the worker sheds load with 503.
QUEUE_LIMIT=50

# Callback delivery retries and linear backoff (ms).
CALLBACK_RETRIES=4
CALLBACK_BACKOFF_MS=3000

# How long a seen request nonce is remembered (ms).
NONCE_TTL_MS=3600000

# Recorded with every verdict, for traceability.
SCANNER_NAME=clamav-worker
SCANNER_VERSION=
