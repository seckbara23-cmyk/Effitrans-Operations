# ---------------------------------------------------------------------------
# DEV SCAN STUB — development only. NO REAL SECRET BELONGS IN THIS FILE.
# ---------------------------------------------------------------------------

# REQUIRED, and it is a deliberate speed bump. The stub refuses to start
# without it.
DEV_SCAN_STUB_ACK=i-know-this-is-not-a-scanner

# REQUIRED. Must match CUSTOMS_SCAN_CALLBACK_SECRET on your LOCAL Effitrans.
# Generate a throwaway one: openssl rand -hex 32
EFFITRANS_SCAN_SECRET=dev-only-secret-change-me

# REQUIRED, and it MUST be loopback. The stub refuses to start otherwise, which
# is what makes it incapable of answering a deployed environment.
EFFITRANS_CALLBACK_URL=http://localhost:3000/api/customs/reference/scan-callback

PORT=8099
